# Every dependency in this repo is pinned to an exact version: the vendored
# tree-sitter-bash fork (lib/grammar/) is derived from a specific upstream
# revision, and the compiled parser is loaded by a specific tree-sitter
# runtime. A caret range turns either bump into a surprise on someone else's
# install. This makes `pnpm add` / `npm install <pkg>` default to exact too,
# so new dependencies do not quietly arrive with a range.
save-exact=true
